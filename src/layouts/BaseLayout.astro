---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
}

import MagneticButtons from '../components/effects/MagneticButtons';
import PointerLight from '../components/effects/PointerLight';
import RevealOnScroll from '../components/effects/RevealOnScroll';
import ScrollProgress from '../components/effects/ScrollProgress';

const {
  title,
  description = 'Análisis, explicaciones, teorías y debates sobre FROM.',
  ogImage = '/assets/profile-landscape-hd.jpg',
  bodyClass = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://elhombredeamarillo.com');
const BASE_URL = Astro.site?.href ?? 'https://elhombredeamarillo.com';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070805" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.com').href} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.com').href} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Preload hero image (LCP) -->
    <link rel="preload" as="image" href="/assets/profile-landscape-hd.jpg" fetchpriority="high" />

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Google Fonts (async, no render-blocking) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=VT323&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=VT323&display=swap" rel="stylesheet" />
    </noscript>

    <title>{title}</title>

    <!-- Apply saved zoom before render to avoid flash -->
    <script is:inline>
      (function() {
        var s = localStorage.getItem('zoom-level');
        if (s) document.documentElement.style.zoom = s + '%';
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';
    </style>

    <slot name="head" />
  </head>
  <body class:list={['bg-bg text-text font-body antialiased', bodyClass]}>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'El Hombre de Amarillo',
      url: BASE_URL,
      description: 'Análisis, explicaciones, teorías y debates sobre FROM.',
      inLanguage: 'es',
    })} />
    <ScrollProgress client:idle />
    <PointerLight client:idle />
    <RevealOnScroll client:visible />
    <MagneticButtons client:visible />
    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' });
        });
      }
    </script>
  </body>
</html>
