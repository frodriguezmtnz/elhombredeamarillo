---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  preloadHero?: boolean;
}

import { ClientRouter } from 'astro:transitions';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-ext-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/jetbrains-mono/latin-ext-700.css';
import '@fontsource/vt323/latin.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title,
  description = 'Análisis, explicaciones, teorías y debates sobre FROM.',
  ogImage = '/assets/profile-landscape-hd.jpg',
  bodyClass = '',
  preloadHero = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://elhombredeamarillo.vercel.app');
const BASE_URL = Astro.site?.href ?? 'https://elhombredeamarillo.vercel.app';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070805" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.vercel.app').href} />
    <meta property="og:image:width" content="1268" />
    <meta property="og:image:height" content="622" />
    <meta property="og:site_name" content="El Hombre de Amarillo" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@koiboy_OG" />
    <meta name="twitter:creator" content="@koiboy_OG" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.vercel.app').href} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Preload hero image (LCP), solo en páginas que la renderizan -->
    {preloadHero && (
      <link rel="preload" as="image" href="/assets/profile-landscape-hd.jpg" fetchpriority="high" />
    )}

    <!-- DNS prefetch + preconnect para thumbnails de YouTube -->
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />

    <title>{title}</title>

    <ClientRouter />

    <!-- Apply saved zoom before render to avoid flash -->
    <script is:inline>
      (function() {
        var s = localStorage.getItem('zoom-level');
        if (s) document.documentElement.style.zoom = s + '%';
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';

      /* ─── View Transitions: fade personalizada ─── */
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      ::view-transition-old(root) {
        animation: fade-out 0.2s ease-in both;
      }
      ::view-transition-new(root) {
        animation: fade-in 0.25s ease-out both;
      }

      /* Persistir header: sin animación de transición */
      ::view-transition-old(site-header),
      ::view-transition-new(site-header) {
        animation: none;
      }

      /* ScrollProgress se mantiene visible durante transiciones */
      ::view-transition-old(scroll-progress),
      ::view-transition-new(scroll-progress) {
        animation: none;
      }
    </style>

    <slot name="head" />
  </head>
  <body class:list={['bg-bg text-text font-body antialiased', bodyClass]}>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'El Hombre de Amarillo',
      url: BASE_URL,
      description: 'Análisis, explicaciones, teorías y debates sobre FROM.',
      inLanguage: 'es',
    })} />
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 h-[2px] bg-yellow z-[60] transition-none"
      style="width:0%"
      aria-hidden="true"
    />
    <slot />

    <Analytics />
    <SpeedInsights />

    <script is:inline>
      // ── ScrollProgress: barra superior de lectura ──
      (function () {
        var bar = document.getElementById('scroll-progress');
        if (!bar) return;
        var update = function () {
          var y = window.scrollY || 0;
          var doc = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = (doc > 0 ? (y / doc) * 100 : 0) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        document.addEventListener('astro:page-load', update);
      })();
    </script>

    <script is:inline>
      // ── PointerLight: luz reactiva al cursor ──
      (function () {
        var root = document.documentElement;
        window.addEventListener(
          'mousemove',
          function (e) {
            root.style.setProperty('--cursor-x', e.clientX + 'px');
            root.style.setProperty('--cursor-y', e.clientY + 'px');
          },
          { passive: true },
        );
      })();
    </script>

    <script is:inline>
      // ── RevealOnScroll ──
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;
        var observer;
        function init() {
          var els = document.querySelectorAll('.reveal-item:not(.in-view)');
          if (els.length === 0) return;
          if (!observer) {
            observer = new IntersectionObserver(
              function (entries) {
                for (var i = 0; i < entries.length; i++) {
                  var en = entries[i];
                  if (en.isIntersecting) {
                    en.target.classList.add('in-view');
                    observer.unobserve(en.target);
                  }
                }
              },
              { threshold: 0.15 },
            );
          }
          for (var j = 0; j < els.length; j++) observer.observe(els[j]);
        }
        init();
        document.addEventListener('astro:page-load', init);
      })();
    </script>

    <script is:inline>
      // ── MagneticButtons ──
      (function () {
        if (window.innerWidth <= 768) return;
        var btns = document.querySelectorAll('.magnetic');
        if (btns.length === 0) return;
        var move = function (e) {
          var b = e.currentTarget;
          var r = b.getBoundingClientRect();
          var x = e.clientX - r.left - r.width / 2;
          var y = e.clientY - r.top - r.height / 2;
          b.style.transform = 'translate(' + x * 0.2 + 'px, ' + y * 0.2 + 'px)';
        };
        var leave = function (e) {
          e.currentTarget.style.transform = 'translate(0, 0)';
        };
        for (var i = 0; i < btns.length; i++) {
          btns[i].addEventListener('mousemove', move);
          btns[i].addEventListener('mouseleave', leave);
        }
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
          }
        });
      }
    </script>
  </body>
</html>
