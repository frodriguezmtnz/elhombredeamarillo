---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  preloadHero?: boolean;
}

import { ClientRouter } from 'astro:transitions';
import MagneticButtons from '../components/effects/MagneticButtons';
import PointerLight from '../components/effects/PointerLight';
import RevealOnScroll from '../components/effects/RevealOnScroll';
import ScrollProgress from '../components/effects/ScrollProgress';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/vt323';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title,
  description = 'Análisis, explicaciones, teorías y debates sobre FROM.',
  ogImage = '/assets/profile-landscape-hd.jpg',
  bodyClass = '',
  preloadHero = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://elhombredeamarillo.com');
const BASE_URL = Astro.site?.href ?? 'https://elhombredeamarillo.com';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070805" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.com').href} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://elhombredeamarillo.com').href} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Preload hero image (LCP), solo en páginas que la renderizan -->
    {preloadHero && (
      <link rel="preload" as="image" href="/assets/profile-landscape-hd.jpg" fetchpriority="high" />
    )}

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://i.ytimg.com" />

    <title>{title}</title>

    <ClientRouter />

    <!-- Apply saved zoom before render to avoid flash -->
    <script is:inline>
      (function() {
        var s = localStorage.getItem('zoom-level');
        if (s) document.documentElement.style.zoom = s + '%';
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';

      /* ─── View Transitions: fade personalizada ─── */
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      ::view-transition-old(root) {
        animation: fade-out 0.2s ease-in both;
      }
      ::view-transition-new(root) {
        animation: fade-in 0.25s ease-out both;
      }

      /* Persistir header: sin animación de transición */
      ::view-transition-old(site-header),
      ::view-transition-new(site-header) {
        animation: none;
      }

      /* ScrollProgress se mantiene visible durante transiciones */
      ::view-transition-old(scroll-progress),
      ::view-transition-new(scroll-progress) {
        animation: none;
      }
    </style>

    <slot name="head" />
  </head>
  <body class:list={['bg-bg text-text font-body antialiased', bodyClass]}>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'El Hombre de Amarillo',
      url: BASE_URL,
      description: 'Análisis, explicaciones, teorías y debates sobre FROM.',
      inLanguage: 'es',
    })} />
    <ScrollProgress client:idle />
    <PointerLight client:idle />
    <RevealOnScroll client:idle />
    <MagneticButtons client:visible />
    <slot />

    <Analytics />
    <SpeedInsights />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
          }
        });
      }
    </script>
  </body>
</html>
