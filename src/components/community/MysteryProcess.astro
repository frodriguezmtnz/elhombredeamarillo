---
const steps = [
  {
    number: '01',
    title: 'RECIBIMOS',
    description: 'Recogemos las preguntas que la comunidad repite en comentarios y redes.',
  },
  {
    number: '02',
    title: 'AGRUPAMOS',
    description: 'Clasificamos cada misterio por categoría y vinculamos las menciones.',
  },
  { number: '03', title: 'EXPLICAMOS', description: 'La comunidad propone hipótesis para cada misterio abierto.' },
  { number: '04', title: 'VOTAMOS', description: 'Los votos ordenan las explicaciones por apoyo colectivo.' },
];
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
  {steps.map((step) => (
    <div class="p-4 rounded-xl border border-border bg-surface text-center">
      <span class="text-yellow/40 font-pixel text-3xl">{step.number}</span>
      <h4 class="mt-2 font-pixel text-lg uppercase">{step.title}</h4>
      <p class="mt-1 text-text-muted text-[11px] leading-relaxed">{step.description}</p>
    </div>
  ))}
</div>
