---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/60 mt-auto">
  <div class="mx-auto max-w-[var(--shell)] px-5 py-10 lg:px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Brand -->
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full border border-border bg-surface-raised overflow-hidden p-1">
          <svg viewBox="0 0 64 64" class="w-full h-full" aria-hidden="true">
            <rect width="64" height="64" fill="#0b0d0c" />
            <rect x="8" y="12" width="48" height="40" fill="#d2a62a" />
            <rect x="14" y="18" width="36" height="28" fill="#151816" />
            <rect x="20" y="24" width="8" height="8" fill="#e6dfca" />
            <rect x="36" y="24" width="8" height="8" fill="#e6dfca" />
            <rect x="28" y="34" width="8" height="6" fill="#d2a62a" />
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-bold tracking-[.14em] text-text-muted uppercase font-mono">Archivo de contenido</div>
          <div class="text-xs font-bold tracking-widest text-yellow uppercase font-mono mt-0.5">El Hombre de Amarillo</div>
        </div>
      </div>

      <!-- Social -->
      <nav class="flex flex-wrap items-center gap-5" aria-label="Redes sociales">
        <a
          href="https://www.instagram.com/el_hombre_de_amarillo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-text-muted hover:text-yellow transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://discord.com/invite/Nq855qtNFX"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord"
          class="text-text-muted hover:text-yellow transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.36-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.01 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02ZM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12Zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12Z" />
          </svg>
        </a>
        <a
          href="https://www.youtube.com/@koiboy_OG"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="text-text-muted hover:text-yellow transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </nav>
    </div>

    <!-- Bottom -->
    <div class="mt-8 pt-6 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="text-[10px] text-text-muted font-mono">
        © {year} El Hombre de Amarillo. Todos los derechos reservados.
      </div>
      <div class="text-[10px] text-text-muted font-mono tracking-widest uppercase">
        Análisis · Explicaciones · Teorías
      </div>
    </div>
  </div>
</footer>
