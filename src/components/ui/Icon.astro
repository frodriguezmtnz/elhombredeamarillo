---
import { icons } from 'lucide';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  name: keyof typeof icons;
  size?: number;
  'stroke-width'?: number;
}

const {
  name,
  size = 24,
  'stroke-width': strokeWidth = 2,
  class: className,
  ...rest
} = Astro.props;

function buildSvgString(children: [string, Record<string, string | number>][], attrs: Record<string, string | number>): string {
  const childrenStr = children
    .map(([tag, childAttrs]) => `<${tag} ${Object.entries(childAttrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`)
    .join('');
  const svgAttrs = Object.entries(attrs)
    .map(([k, v]) => `${k}="${v}"`)
    .join(' ');
  return `<svg ${svgAttrs}>${childrenStr}</svg>`;
}

const iconData = icons[name];
const svgString = buildSvgString(iconData, {
  'xmlns': 'http://www.w3.org/2000/svg',
  'width': size,
  'height': size,
  'viewBox': '0 0 24 24',
  'fill': 'none',
  'stroke': 'currentColor',
  'stroke-width': strokeWidth,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  ...(className ? { 'class': className } : {}),
  ...Object.fromEntries(
    Object.entries(rest).filter(([k]) => k !== 'set:html').map(([k, v]) => [k, v as string | number])
  ),
});
---

<Fragment set:html={svgString} />
