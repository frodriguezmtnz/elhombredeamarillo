---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'INICIO' },
  { href: '/videos', label: 'VÍDEOS' },
  { href: '/expedientes', label: 'EXPEDIENTES' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-[var(--shell)] flex items-center justify-between px-5 py-4 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 no-underline group">
      <div class="w-11 h-11 rounded-full border border-border bg-surface-raised overflow-hidden group-hover:border-yellow transition-colors p-1.5">
        <svg viewBox="0 0 64 64" class="w-full h-full" aria-hidden="true">
          <rect width="64" height="64" fill="#0b0d0c" />
          <rect x="8" y="12" width="48" height="40" fill="#d2a62a" />
          <rect x="14" y="18" width="36" height="28" fill="#151816" />
          <rect x="20" y="24" width="8" height="8" fill="#e6dfca" />
          <rect x="36" y="24" width="8" height="8" fill="#e6dfca" />
          <rect x="28" y="34" width="8" height="6" fill="#d2a62a" />
        </svg>
      </div>
      <div class="hidden sm:block">
        <div class="text-xs font-bold tracking-widest text-yellow uppercase font-mono">El Hombre</div>
        <div class="text-[10px] tracking-widest text-text-muted uppercase font-mono">de Amarillo</div>
      </div>
    </a>

    <!-- Desktop nav + controls -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-4 py-2 text-[10px] font-bold tracking-[.12em] uppercase font-mono rounded-lg transition-colors',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-bg bg-yellow'
              : 'text-text-muted hover:text-yellow hover:bg-yellow/10',
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Zoom + Fullscreen -->
      <div class="flex items-center gap-0.5 ml-3 pl-3 border-l border-border/50">
        <button id="zoom-out" type="button" class="cursor-zoom-out zoom-btn w-7 h-7 flex items-center justify-center text-text-muted hover:text-yellow rounded transition-colors" aria-label="Reducir zoom">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button id="zoom-display" type="button" class="cursor-pointer min-w-[40px] h-7 px-1 text-center text-[9px] font-bold tracking-wider text-text-muted font-mono rounded hover:text-yellow transition-colors" aria-label="Restablecer zoom a 100%">
          <span id="zoom-value">100%</span>
        </button>
        <button id="zoom-in" type="button" class="cursor-zoom-in zoom-btn w-7 h-7 flex items-center justify-center text-text-muted hover:text-yellow rounded transition-colors" aria-label="Aumentar zoom">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 2.5v7M2.5 6h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button id="fullscreen-toggle" type="button" class="cursor-crosshair w-7 h-7 flex items-center justify-center text-text-muted hover:text-yellow rounded transition-colors ml-1" aria-label="Pantalla completa" data-state="normal">
          <svg id="fs-expand" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1.5 5V1.5H5M9 1.5H12.5V5M12.5 9V12.5H9M5 12.5H1.5V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg id="fs-compress" width="14" height="14" viewBox="0 0 14 14" fill="none" class="hidden">
            <path d="M5 1.5V4H1.5M9 1.5H12.5V5M9 12.5V10H12.5M5 10H1.5V12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden w-10 h-10 flex items-center justify-center text-text-muted hover:text-yellow transition-colors"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="md:hidden hidden bg-surface/95 backdrop-blur-lg border-t border-border"
    aria-label="Navegación móvil"
  >
    <div class="flex flex-col p-4 gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-4 py-3 text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-lg transition-colors',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-bg bg-yellow'
              : 'text-text-muted hover:text-yellow hover:bg-yellow/10',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Scroll effect
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 80) {
      header?.classList.add('bg-bg/90', 'backdrop-blur-lg', 'border-b', 'border-border');
    } else {
      header?.classList.remove('bg-bg/90', 'backdrop-blur-lg', 'border-b', 'border-border');
    }
    lastScroll = scrollY;
  }, { passive: true });

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // ── Zoom + Fullscreen ──
  const MIN = 80;
  const MAX = 150;
  const STEP = 10;
  const STORAGE_KEY = 'zoom-level';

  const zoomOut = document.getElementById('zoom-out');
  const zoomIn = document.getElementById('zoom-in');
  const zoomDisplay = document.getElementById('zoom-display');
  const zoomValue = document.getElementById('zoom-value');
  const fsToggle = document.getElementById('fullscreen-toggle');
  const fsExpand = document.getElementById('fs-expand');
  const fsCompress = document.getElementById('fs-compress');

  let zoomLevel = parseInt(localStorage.getItem(STORAGE_KEY) || '100', 10);

  function applyZoom(level) {
    zoomLevel = Math.min(MAX, Math.max(MIN, level));
    document.documentElement.style.zoom = zoomLevel + '%';
    if (zoomValue) zoomValue.textContent = zoomLevel + '%';
    localStorage.setItem(STORAGE_KEY, String(zoomLevel));
  }

  // Apply saved zoom immediately
  applyZoom(zoomLevel);

  zoomOut?.addEventListener('click', () => applyZoom(zoomLevel - STEP));
  zoomIn?.addEventListener('click', () => applyZoom(zoomLevel + STEP));
  zoomDisplay?.addEventListener('click', () => applyZoom(100));

  // Fullscreen toggle
  function updateFsButton() {
    const isFs = !!document.fullscreenElement;
    fsExpand?.classList.toggle('hidden', isFs);
    fsCompress?.classList.toggle('hidden', !isFs);
    fsToggle?.setAttribute('aria-label', isFs ? 'Salir de pantalla completa' : 'Pantalla completa');
  }

  fsToggle?.addEventListener('click', async () => {
    if (document.fullscreenElement) {
      await document.exitFullscreen();
    } else {
      await document.documentElement.requestFullscreen();
    }
  });

  document.addEventListener('fullscreenchange', updateFsButton);
</script>
