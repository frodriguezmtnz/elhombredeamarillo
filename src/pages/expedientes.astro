---
import ExpedientesBoard from '../components/cases/ExpedientesBoard';
import CommunityBoard from '../components/community/CommunityBoard';
import MysteryProcess from '../components/community/MysteryProcess.astro';
import BottleTree from '../components/effects/BottleTree';
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import { CASES_META, DOSSIERS, SOURCES } from '../data/cases';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Expedientes — El Hombre de Amarillo"
  description="Archivo interactivo de teorías de FROM: expedientes, pruebas, dudas y evolución a través de los vídeos."
  ogImage="/assets/profile-landscape-hd.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://elhombredeamarillo.vercel.app/' },
        { '@type': 'ListItem', position: 2, name: 'Expedientes', item: 'https://elhombredeamarillo.vercel.app/expedientes/' },
      ],
    })} />
  </Fragment>
  <Header />

  <main class="pt-[var(--header-h)]">
    <!-- Hero de expedientes -->
    <section class="relative overflow-hidden" aria-labelledby="cases-title">
      <BottleTree client:idle />
      <div class="absolute inset-0 z-[1] bg-gradient-to-b from-bg/60 via-bg/10 to-bg pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-yellow/5 via-transparent to-rust/5"></div>
      <div class="relative mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16 lg:py-24">
        <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-3">ACCESO RESTRINGIDO // ARCHIVO DE FROM</p>
        <h1 class="font-pixel text-[clamp(2.5rem,7vw,5rem)] uppercase leading-[0.85]" id="cases-title">
          EXPEDIENTES
        </h1>
        <p class="mt-4 max-w-[60ch] text-text-muted text-sm leading-relaxed">
          Una sala para conectar las grandes teorías del canal y una cronología que conserva cómo nacieron,
          cambiaron o quedaron en duda a medida que avanzó la serie.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap gap-3 mt-8">
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-surface/60">
            <span class="font-pixel text-xl text-yellow">{DOSSIERS.length}</span>
            <span class="text-[9px] font-bold tracking-[.1em] text-text-muted uppercase font-mono">EXPEDIENTES</span>
          </div>
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-surface/60">
            <span class="font-pixel text-xl text-yellow">{SOURCES.length}</span>
            <span class="text-[9px] font-bold tracking-[.1em] text-text-muted uppercase font-mono">VÍDEOS TRANSCRITOS</span>
          </div>
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-surface/60">
            <span class="font-pixel text-xl text-yellow">{CASES_META.baseTheories}</span>
            <span class="text-[9px] font-bold tracking-[.1em] text-text-muted uppercase font-mono">TEORÍAS NÚCLEO</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Método de archivo -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16" aria-labelledby="method-title">
      <div class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-10 items-center">
        <div class="reveal-item">
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">MÉTODO DE ARCHIVO</p>
          <h2 class="font-pixel text-[clamp(1.5rem,4vw,2.5rem)] uppercase" id="method-title">DOS CAPAS, UNA MISMA INVESTIGACIÓN</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <article class="p-5 rounded-2xl border border-border bg-surface reveal-item stagger">
            <span class="text-yellow/40 font-pixel text-3xl">01</span>
            <h3 class="mt-3 font-pixel text-lg uppercase">EXPEDIENTES</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">
              Agrupan las ideas para leer una teoría completa, comparar pruebas y saltar a conexiones relacionadas.
            </p>
          </article>
          <article class="p-5 rounded-2xl border border-border bg-surface reveal-item stagger">
            <span class="text-yellow/40 font-pixel text-3xl">02</span>
            <h3 class="mt-3 font-pixel text-lg uppercase">CRONOLOGÍA</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">
              Mantiene el recorrido de los vídeos para que una conclusión posterior no borre la formulación original.
            </p>
          </article>
          <article class="p-5 rounded-2xl border border-border bg-surface reveal-item stagger">
            <span class="text-yellow/40 font-pixel text-3xl">03</span>
            <h3 class="mt-3 font-pixel text-lg uppercase">ESTADOS</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">
              Diferencia hipótesis centrales, alternativas abiertas, teorías derivadas y ejercicios de reinterpretación.
            </p>
          </article>
        </div>
      </div>
    </section>


    <!-- Muro de teorías -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16" aria-labelledby="archive-title">
      <header class="flex items-end justify-between gap-6 mb-8 reveal-item">
        <div>
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">SALA DE INVESTIGACIÓN // EVIDENCE BOARD</p>
          <h2 class="font-pixel text-[clamp(1.5rem,4vw,2.5rem)] uppercase" id="archive-title">MURO DE TEORÍAS</h2>
        </div>
      </header>

      <!-- React island: Board interactivo -->
      <div class="reveal-item">
        <ExpedientesBoard client:visible dossiers={DOSSIERS} sources={SOURCES} />
      </div>
    </section>


    <!-- Comunidad: proceso + misterios -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16 border-t border-border" aria-labelledby="community-title">
      <header class="flex items-end justify-between gap-6 mb-8 reveal-item">
        <div>
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">ARCHIVO COMUNITARIO // TEMPORADA 5</p>
          <h2 class="font-pixel text-[clamp(1.5rem,4vw,2.5rem)] uppercase" id="community-title">MISTERIOS BAJO VOTACIÓN</h2>
          <p class="mt-2 max-w-[60ch] text-text-muted text-sm">
            El archivo agrupa preguntas repetidas, abre una sala de hipótesis para cada misterio y ordena las explicaciones según el apoyo de la comunidad.
          </p>
        </div>
      </header>

      <!-- Proceso (HTML estático) -->
      <div class="mb-8 reveal-item">
        <MysteryProcess />
      </div>

      <!-- React island: Board comunitario -->
      <div class="reveal-item">
        <CommunityBoard client:visible />
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
