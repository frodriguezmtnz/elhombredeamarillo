---
import { Image, getImage } from 'astro:assets';
import heroLandscape from '../assets/profile-landscape-hd.jpg';
import Crows from '../components/effects/Crows';
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import Icon from '../components/ui/Icon.astro';
import { VIDEOS, getRecentVideos } from '../data/videos';
import BaseLayout from '../layouts/BaseLayout.astro';
import { relativeTime } from '../lib/utils';
import { fetchVideosAtBuild } from '../lib/videos-catalog';
import { pickVideos } from '../lib/videos-service';
import { thumbnailRemoteUrl, thumbnailUrl } from '../lib/youtube';

const heroImg = await getImage({ src: heroLandscape, width: 1268, height: 622 });
const remote = await fetchVideosAtBuild();
const catalog = pickVideos(VIDEOS, remote);
const recentVideos = getRecentVideos(6, catalog);
---

<BaseLayout
  title="El Hombre de Amarillo"
  description="Página oficial de El Hombre de Amarillo: análisis, teorías y debates sobre FROM y otras historias de misterio."
  ogImage="/assets/profile-landscape-hd.jpg"
>
  <link slot="head" rel="preload" as="image" href={heroImg.src} fetchpriority="high" />
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center overflow-hidden" aria-labelledby="home-title">
      <!-- Background image -->
      <div class="absolute inset-0 z-0">
        <Image
          src={heroLandscape}
          alt=""
          width="1268"
          height="622"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover opacity-40"
        />
      </div>
      <!-- <Crows client:idle /> -->
      <div class="absolute inset-0 z-[1] bg-gradient-to-b from-bg/60 via-bg/40 to-bg"></div>

      <div class="relative z-10 mx-auto max-w-[var(--shell)] w-full px-5 lg:px-8 py-32">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 items-center">
          <!-- Copy -->
          <div>
            <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-4">
              CANAL DE YOUTUBE // @KOIBOY_OG
            </p>
            <h1 class="font-pixel text-[clamp(3rem,8vw,7rem)] leading-[0.85] uppercase tracking-tight" id="home-title">
              <span class="block">EL HOMBRE</span>
              <span class="block text-yellow">DE AMARILLO</span>
            </h1>
            <p class="mt-6 max-w-[52ch] text-text-muted text-sm leading-relaxed">
              El típico amigo con el que comentas tus series y películas favoritas. FROM es el centro
              de una investigación que mezcla análisis, teorías, pistas y debates con otros creadores.
            </p>
            <div class="flex flex-wrap gap-3 mt-8">
              <a
                href="/videos"
                class="inline-flex items-center gap-4 min-h-[48px] px-5 bg-yellow text-bg text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl hover:brightness-110 transition-all"
              >
                <span>ENTRAR EN LA SALA DE VÍDEOS</span><b>→</b>
              </a>
              <a
                href="/expedientes"
                class="inline-flex items-center gap-4 min-h-[48px] px-5 border border-border text-text text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl hover:border-yellow hover:text-yellow transition-all"
              >
                ABRIR LOS EXPEDIENTES<b>↗</b>
              </a>
            </div>
          </div>

          <!-- Signature -->
          <a
            href="https://www.youtube.com/@koiboy_OG"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden lg:flex flex-col items-center gap-4 group/avatar"
            aria-label="Visitar canal de YouTube de El Hombre de Amarillo"
          >
            <div class="w-[180px] h-[180px] rounded-full border-2 border-yellow/30 overflow-hidden shadow-[0_0_40px_rgba(244,201,67,0.15)] group-hover/avatar:border-yellow group-hover/avatar:shadow-[0_0_60px_rgba(244,201,67,0.3)] group-hover/avatar:scale-105 transition-all duration-300">
              <img
                src="/assets/channel-avatar-premium.jpg"
                alt="Foto de perfil de El Hombre de Amarillo"
                width="1254"
                height="1254"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="text-center group-hover/avatar:text-yellow transition-colors">
              <div class="text-[9px] font-bold tracking-[.14em] text-text-muted uppercase font-mono">ANÁLISIS // TEORÍAS // DEBATES</div>
              <div class="text-xs font-bold tracking-widest text-yellow uppercase font-mono mt-1">+19k SUSCRIPTORES</div>
              <div class="mt-2 text-[9px] font-bold tracking-[.1em] text-yellow/0 group-hover/avatar:text-yellow/80 uppercase font-mono transition-all duration-300 translate-y-1 group-hover/avatar:translate-y-0">
                IR AL CANAL ↗
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Scroll cue -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
        <div class="w-[3px] h-10 bg-gradient-to-b from-yellow/70 to-transparent animate-pulse"></div>
        <span class="text-[11px] font-bold tracking-[.14em] text-text-muted uppercase font-mono animate-pulse">CONTINUAR</span>
      </div>
    </section>

    <!-- Portals -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-20" aria-labelledby="portals-title">
      <header class="flex items-end justify-between gap-6 mb-10 reveal-item">
        <div>
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">TRES FORMAS DE ENTRAR</p>
          <h2 class="font-pixel text-[clamp(2rem,4.5vw,3.5rem)] uppercase" id="portals-title">EXPLORA EL ARCHIVO</h2>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Análisis -->
        <a href="/videos?category=analysis" class="group relative overflow-hidden rounded-2xl border border-border bg-surface hover:border-yellow/40 transition-all reveal-item stagger">
          <img
            src={thumbnailUrl('n89wAW_gT3Q')}
            alt="Miniatura de un análisis"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="w-full aspect-video object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          />
          <div class="p-5">
            <span class="text-[9px] font-bold tracking-[.12em] text-yellow/60 uppercase font-mono">01 // INVESTIGACIÓN</span>
            <h3 class="mt-2 font-pixel text-2xl uppercase">Análisis y teorías</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">Revelaciones, conexiones, símbolos y posibilidades construidas episodio a episodio.</p>
            <span class="inline-block mt-4 text-[10px] font-bold tracking-[.12em] text-yellow uppercase font-mono">ENTRAR EN LOS ANÁLISIS →</span>
          </div>
        </a>

        <!-- Debates -->
        <a href="/videos?category=debate" class="group relative overflow-hidden rounded-2xl border border-border bg-surface hover:border-yellow/40 transition-all reveal-item stagger">
          <img
            src={thumbnailUrl('Kc0SnZH6KPY')}
            alt="Miniatura de un debate con creadores"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="w-full aspect-video object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          />
          <div class="p-5">
            <span class="text-[9px] font-bold tracking-[.12em] text-yellow/60 uppercase font-mono">02 // MESA ABIERTA</span>
            <h3 class="mt-2 font-pixel text-2xl uppercase">Debates con creadores</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">Ideas enfrentadas, invitados recurrentes y conversaciones tras cada nuevo episodio.</p>
            <span class="inline-block mt-4 text-[10px] font-bold tracking-[.12em] text-yellow uppercase font-mono">ENTRAR EN LOS DEBATES →</span>
          </div>
        </a>

        <!-- Expedientes -->
        <a href="/expedientes" class="group relative overflow-hidden rounded-2xl border border-border bg-surface hover:border-yellow/40 transition-all reveal-item stagger">
          <img
            src="/assets/references/bosslogic-from-t5-fanart.webp"
            alt="Fanart de FROM"
            width="448"
            height="593"
            loading="lazy"
            decoding="async"
            class="w-full aspect-video object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          />
          <div class="p-5">
            <span class="text-[9px] font-bold tracking-[.12em] text-yellow/60 uppercase font-mono">03 // SALA RESTRINGIDA</span>
            <h3 class="mt-2 font-pixel text-2xl uppercase">Expedientes</h3>
            <p class="mt-2 text-text-muted text-xs leading-relaxed">Un muro de pruebas y una cronología para seguir cómo nacen, cambian o se debilitan las teorías.</p>
            <span class="inline-block mt-4 text-[10px] font-bold tracking-[.12em] text-yellow uppercase font-mono">ABRIR EL MURO →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- THE ROAD — juego original -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 pb-20" aria-labelledby="game-title">
      <a
        href="/the-road/"
        class="group relative block overflow-hidden rounded-2xl border border-border bg-surface hover:border-yellow/40 transition-all reveal-item"
      >
        <div class="absolute inset-0 z-0 bg-gradient-to-r from-yellow/[.06] via-transparent to-transparent"></div>
        <div class="relative p-8 lg:p-12">
          <span class="text-[9px] font-bold tracking-[.12em] text-yellow/60 uppercase font-mono">04 // JUEGO ORIGINAL</span>
          <h3 class="mt-2 font-pixel text-[clamp(1.8rem,4vw,3rem)] uppercase" id="game-title">THE ROAD</h3>
          <p class="mt-3 max-w-[52ch] text-text-muted text-sm leading-relaxed">
            Un juego de horror en 3D para el navegador, 100% original. Conduce de noche por una
            carretera que no aparece en ningún mapa, baja a examinar el árbol caído y descubre qué
            ocurre con Marrow Falls.
          </p>
          <span
            class="inline-flex items-center gap-3 mt-6 min-h-[44px] px-5 bg-yellow text-bg text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl group-hover:brightness-110 transition-all"
          >
            JUGAR EN EL NAVEGADOR <b>→</b>
          </span>
        </div>
      </a>
    </section>

    <!-- TRIVIAL DEL PUEBLO — juego de preguntas -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 pb-20" aria-labelledby="trivial-home-title">
      <a
        href="/trivial"
        class="group relative block overflow-hidden rounded-2xl border border-border bg-surface hover:border-yellow/40 transition-all reveal-item"
      >
        <div class="absolute inset-0 z-0 bg-gradient-to-l from-yellow/[.06] via-transparent to-transparent"></div>
        <div class="relative p-8 lg:p-12">
          <span class="text-[9px] font-bold tracking-[.12em] text-yellow/60 uppercase font-mono">05 // PRUEBA DE INICIACIÓN</span>
          <h3 class="mt-2 font-pixel text-[clamp(1.8rem,4vw,3rem)] uppercase" id="trivial-home-title">TRIVIAL DEL PUEBLO</h3>
          <p class="mt-3 max-w-[52ch] text-text-muted text-sm leading-relaxed">
            ¿Conoces de verdad las reglas del pueblo? Responde antes de que suene la campana de Boyd:
            reglas, criaturas, personajes, producción y secretos del archivo, del Cautivo al
            Hombre de Amarillo.
          </p>
          <span
            class="inline-flex items-center gap-3 mt-6 min-h-[44px] px-5 bg-yellow text-bg text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl group-hover:brightness-110 transition-all"
          >
            EMPEZAR LA PRUEBA <b>→</b>
          </span>
        </div>
      </a>
    </section>

    <!-- Últimas publicaciones: carrusel auto-avanzado (script vanilla, sin hidratación) -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-20 border-t border-border" aria-labelledby="recent-title">
      <header class="flex items-end justify-between gap-6 mb-10 reveal-item">
        <div>
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">ÚLTIMAS PUBLICACIONES</p>
          <h2 class="font-pixel text-[clamp(2rem,4.5vw,3.5rem)] uppercase" id="recent-title">AHORA EN EL CANAL</h2>
        </div>
        <div class="hidden sm:flex items-center gap-4">
          <a href="/videos" class="text-[10px] font-bold tracking-[.12em] text-text-muted hover:text-yellow uppercase font-mono transition-colors">
            EXPLORAR TODA LA BIBLIOTECA →
          </a>
          <div class="flex gap-2">
            <button
              type="button"
              data-recent-prev
              aria-label="Publicación anterior"
              class="w-10 h-10 grid place-items-center rounded-lg border border-border bg-surface text-text-muted hover:border-yellow hover:text-yellow transition-colors"
            >
              <Icon name="ChevronLeft" size={18} />
            </button>
            <button
              type="button"
              data-recent-next
              aria-label="Publicación siguiente"
              class="w-10 h-10 grid place-items-center rounded-lg border border-border bg-surface text-text-muted hover:border-yellow hover:text-yellow transition-colors"
            >
              <Icon name="ChevronRight" size={18} />
            </button>
          </div>
        </div>
      </header>

      <div class="relative" data-recent-slider>
        <ul
          class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-recent-track
        >
          {recentVideos.map((video) => (
            <li class="shrink-0 snap-start w-[85%] sm:w-[calc((100%-1.25rem-2rem)/2)] lg:w-[calc((100%-2.5rem-2.5rem)/3)]">
              <a
                href={`https://www.youtube.com/watch?v=${video.videoId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group block h-full rounded-xl border border-border bg-surface overflow-hidden hover:border-yellow/30 transition-all reveal-item stagger"
              >
                <div class="relative">
                  <img
                    src={thumbnailUrl(video.videoId)}
                    alt={video.title}
                    width="480"
                    height="270"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror={`this.onerror=null;this.src='${thumbnailRemoteUrl(video.videoId, 'mqdefault')}'`}
                  />
                  <span class="absolute top-3 left-3 px-2 py-1 bg-bg/80 backdrop-blur text-[9px] font-bold tracking-[.1em] text-yellow uppercase font-mono rounded">
                    {video.code}
                  </span>
                </div>
                <div class="p-4">
                  <h3 class="font-pixel text-lg uppercase leading-tight line-clamp-2">{video.title}</h3>
                  <p class="mt-2 text-text-muted text-xs line-clamp-2">{video.description}</p>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="text-[9px] font-bold tracking-[.1em] text-yellow/60 uppercase font-mono">
                      {video.category === 'analysis' ? 'ANÁLISIS' : 'DEBATE'}
                    </span>
                    {video.publishedAt && (
                      <span class="text-[9px] text-text-muted/60 font-mono">{relativeTime(video.publishedAt)}</span>
                    )}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>

        {recentVideos.length > 1 && (
          <div class="mt-6 flex justify-center gap-2" data-recent-dots>
            {recentVideos.map((video, i) => (
              <button
                type="button"
                class="recent-dot"
                data-recent-dot={i}
                data-state={i === 0 ? 'active' : 'pending'}
                aria-label={`Ir a la publicación ${i + 1}: ${video.title}`}
              >
                <span class="recent-dot-fill" aria-hidden="true"></span>
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Manifesto -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-20 border-t border-border" aria-label="Manifiesto del canal">
      <div class="max-w-3xl mx-auto text-center reveal-item">
        <blockquote class="font-pixel text-[clamp(1.5rem,3.5vw,2.5rem)] leading-snug">
          "En todo ese caos hay un <em class="text-yellow not-italic">orden</em>."
        </blockquote>
        <div class="mt-8 space-y-4 text-text-muted text-sm leading-relaxed">
          <p>
            La web reúne la parte audiovisual del canal y la convierte en una investigación navegable:
            cada vídeo aporta contexto, cada expediente conecta pistas y cada nueva temporada obliga a
            revisar lo que creíamos saber.
          </p>
          <p>
            No se trata de presentar las teorías como hechos, sino de conservar el recorrido que las
            hizo posibles.
          </p>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>

<style>
  .recent-dot {
    position: relative;
    height: 0.375rem;
    width: 1.5rem;
    border-radius: 9999px;
    background-color: var(--color-border);
    overflow: hidden;
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }

  .recent-dot[data-state='active'] {
    width: 2.5rem;
  }

  .recent-dot-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background-color: var(--color-yellow);
  }

  .recent-dot[data-state='done'] .recent-dot-fill {
    width: 100%;
  }

  .recent-dot[data-state='active'] .recent-dot-fill {
    animation: recent-dot-fill 5s linear forwards;
  }

  [data-recent-slider][data-paused='true'] .recent-dot-fill {
    animation-play-state: paused;
  }

  @keyframes recent-dot-fill {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-dot[data-state='active'] .recent-dot-fill {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  // Carrusel de "AHORA EN EL CANAL": bucle infinito, avanza una posición cada 5 s.
  // - Las tarjetas se clonan al final del track (inertes para accesibilidad) para
  //   que la primera entre de nuevo por la derecha sin salto perceptible.
  // - Las flechas (sm+) y los dots navegan y reinician el ciclo.
  // - Los dots se rellenan durante los 5 s (CSS); la pausa los congela y al
  //   reanudar continúan por donde iban.
  // - Pausa en hover y con la pestaña oculta; sin auto-avance con
  //   prefers-reduced-motion.
  const slider = document.querySelector<HTMLElement>('[data-recent-slider]');
  if (slider) {
    const track = slider.querySelector<HTMLElement>('[data-recent-track]');
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-recent-dot]')];
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-recent-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-recent-next]');
    const cards = track ? ([...track.children] as HTMLElement[]) : [];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const INTERVAL = 5000;

    if (track && cards.length > 1) {
      const realCount = cards.length;

      // Clones al final: contenido idéntico para el bucle sin salto. Se ocultan
      // a lectores de pantalla y salen del tab-order, pero siguen siendo clicables
      // (en la última posición la tarjeta vecina visible es un clon). Sin
      // `reveal-item`: el reveal no los observa y quedarían con opacity 0.
      for (const card of cards) {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.classList.remove('reveal-item', 'stagger', 'in-view');
        for (const link of clone.querySelectorAll('a')) {
          link.setAttribute('tabindex', '-1');
        }
        track.appendChild(clone);
      }

      let index = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let remaining = INTERVAL;
      let segmentStart = 0;
      let paused = false;
      let programmaticCount = 0;
      let scrollIdle: ReturnType<typeof setTimeout> | undefined;

      const gap = () => Number.parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      const step = () => cards[0].getBoundingClientRect().width + gap();
      const wrap = (i: number) => ((i % realCount) + realCount) % realCount;

      const renderDots = () => {
        dots.forEach((dot, i) => {
          dot.dataset.state = i < index ? 'done' : i === index ? 'active' : 'pending';
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      // Reinicia el relleno del dot activo; `elapsed` > 0 reanuda a media animación.
      const startFill = (elapsed: number) => {
        const fill = dots[index]?.querySelector<HTMLElement>('.recent-dot-fill');
        if (!fill) return;
        fill.style.animation = 'none';
        void fill.offsetWidth;
        fill.style.animation = '';
        fill.style.animationDelay = elapsed > 0 ? `-${elapsed}ms` : '';
      };

      // Ejecuta `fn` cuando el scroll se asienta (scrollend o, si no existe, timeout).
      const settle = (fn: () => void, fallbackMs = 700) => {
        let done = false;
        const run = () => {
          if (done) return;
          done = true;
          clearTimeout(fallback);
          track.removeEventListener('scrollend', run);
          fn();
        };
        const fallback = setTimeout(run, fallbackMs);
        track.addEventListener('scrollend', run, { once: true });
      };

      const scrollToAbs = (abs: number, smooth: boolean) => {
        programmaticCount += 1;
        track.scrollTo({ left: abs * step(), behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
        settle(() => {
          programmaticCount = Math.max(0, programmaticCount - 1);
        });
      };

      const setIndex = (i: number) => {
        index = wrap(i);
        renderDots();
      };

      const runTimer = () => {
        if (timer) clearTimeout(timer);
        timer = undefined;
        if (reduceMotion.matches || document.hidden || paused || slider.matches(':hover')) return;
        slider.dataset.paused = 'false';
        segmentStart = performance.now();
        startFill(INTERVAL - remaining);
        timer = setTimeout(() => {
          remaining = INTERVAL;
          advance();
        }, Math.max(0, remaining));
      };

      const resetCycle = () => {
        remaining = INTERVAL;
        paused = false;
        runTimer();
      };

      // Avance de una posición con bucle infinito.
      const advance = () => {
        if (index < realCount - 1) {
          setIndex(index + 1);
          scrollToAbs(index, true);
        } else {
          // Desliza hacia el clon de la primera y, al asentarse, salta en silencio al inicio.
          scrollToAbs(realCount, true);
          setIndex(0);
          settle(() => scrollToAbs(0, false));
        }
        resetCycle();
      };

      // Retroceso de una posición con bucle infinito.
      const retreat = () => {
        if (index > 0) {
          setIndex(index - 1);
          scrollToAbs(index, true);
        } else {
          // Salto invisible al clon de la primera, luego desliza hacia la última.
          scrollToAbs(realCount, false);
          setIndex(realCount - 1);
          requestAnimationFrame(() => scrollToAbs(realCount - 1, true));
        }
        resetCycle();
      };

      const pauseTimer = () => {
        if (timer) clearTimeout(timer);
        timer = undefined;
        if (!paused) remaining = Math.max(0, remaining - (performance.now() - segmentStart));
        paused = true;
        slider.dataset.paused = 'true';
      };

      prevBtn?.addEventListener('click', retreat);
      nextBtn?.addEventListener('click', advance);

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          setIndex(i);
          scrollToAbs(index, true);
          resetCycle();
        });
      });

      slider.addEventListener('mouseenter', pauseTimer);
      slider.addEventListener('mouseleave', () => {
        paused = false;
        runTimer();
      });

      // Scroll manual (swipe): sincroniza índice y, si acaba en zona de clones,
      // salta en silencio a la posición real equivalente.
      track.addEventListener(
        'scroll',
        () => {
          if (programmaticCount > 0) return;
          const abs = Math.round(track.scrollLeft / step());
          setIndex(abs);
          if (scrollIdle) clearTimeout(scrollIdle);
          scrollIdle = setTimeout(() => {
            if (abs >= realCount) scrollToAbs(index, false);
            resetCycle();
          }, 160);
        },
        { passive: true },
      );

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pauseTimer();
        else runTimer();
      });

      reduceMotion.addEventListener('change', () => {
        if (reduceMotion.matches) {
          if (timer) clearTimeout(timer);
          timer = undefined;
          renderDots();
        } else {
          resetCycle();
        }
      });

      let resizeIdle: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        if (resizeIdle) clearTimeout(resizeIdle);
        resizeIdle = setTimeout(() => {
          scrollToAbs(index, false);
          renderDots();
          resetCycle();
        }, 150);
      });

      renderDots();
      runTimer();
    }
  }
</script>
