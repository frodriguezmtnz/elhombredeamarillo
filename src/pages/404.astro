---
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import Talisman404 from '../components/ui/Talisman404.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Te has desviado del camino · El Hombre de Amarillo"
  description="Esta ruta no figura en ningún expediente. No hay manera de volver hacia atrás, solo de volver a casa."
  ogImage="/assets/profile-landscape-hd.jpg"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <Header />

  <main class="pt-[var(--header-h)] relative min-h-[calc(100vh-var(--header-h))] overflow-hidden">
    <!-- Ambiente -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(228,183,34,0.05)_0%,rgba(7,8,5,0)_55%)]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-bg/60 via-transparent to-bg"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-8 items-center">
        <!-- Talismán -->
        <div class="flex flex-col items-center gap-6 order-1 lg:order-2">
          <Talisman404 />
          <p class="text-xl mb-10 font-bold tracking-[.14em] text-yellow/60 uppercase font-mono">
            TALISMAN // RUTA NO REGISTRADA
          </p>
        </div>

        <!-- Copy -->
        <div class="order-2 lg:order-1 flex flex-col items-start reveal-item">
          <p class="text-[10px] font-bold tracking-[.14em] text-rust uppercase font-mono mb-4">
            ERROR 404 // PROTOCOLO DE PERDIDOS
          </p>
          <h1 class="font-pixel text-[clamp(3rem,10vw,6.5rem)] leading-[0.85] uppercase" id="error-title">
            <span class="block">EL CAMINO</span>
            <span class="block text-yellow">SE TERMINA AQUÍ</span>
          </h1>
          <p class="mt-6 max-w-[46ch] text-text-muted text-sm leading-relaxed">
            No hay salida en esta dirección: el asfalto se corta, el bosque se cierra y el móvil
            solo marca fuera de cobertura. Algo que quisiste visitar ya no se encuentra — o nunca existió.
          </p>
          <p class="mt-3 max-w-[46ch] text-text-muted/70 text-xs leading-relaxed font-mono">
            > cargo la ruta <span id="bad-path">…</span> … error: no, nada por aquí se reconoce.
          </p>

          <div class="flex flex-wrap gap-3 mt-8">
            <a
              href="/"
              class="inline-flex items-center gap-4 min-h-[48px] px-5 bg-yellow text-bg text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl hover:brightness-110 transition-all magnetic"
            >
              VOLVER A CASA<b>→</b>
            </a>
            <a
              href="/videos"
              class="inline-flex items-center gap-4 min-h-[48px] px-5 border border-border text-text text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl hover:border-yellow hover:text-yellow transition-all"
            >
              VÍDEOS<b>↗</b>
            </a>
            <a
              href="/expedientes"
              class="inline-flex items-center gap-4 min-h-[48px] px-5 border border-border text-text text-[11px] font-bold tracking-[.12em] uppercase font-mono rounded-xl hover:border-yellow hover:text-yellow transition-all"
            >
              EXPEDIENTES<b>↗</b>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const el = document.getElementById('bad-path');
  if (el) el.textContent = window.location.pathname;
</script>