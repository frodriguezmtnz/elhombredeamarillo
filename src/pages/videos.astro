---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import VideoGrid from '../components/videos/VideoGrid';
import { CHANNEL, VIDEOS, getFeaturedVideo } from '../data/videos';
import { thumbnailUrl, channelUrl } from '../lib/youtube';
import { formatChannelNumber, relativeTime } from '../lib/utils';

const featured = getFeaturedVideo();
const category = Astro.url.searchParams.get('category');
---

<BaseLayout
  title="Vídeos — El Hombre de Amarillo"
  description="Todos los vídeos del canal: análisis, explicaciones, teorías y debates sobre FROM."
  ogImage="/assets/profile-landscape-hd.jpg"
>
  <Header />

  <main class="pt-[var(--header-h)]">
    <!-- Hero de vídeos -->
    <section class="relative overflow-hidden border-b border-border" aria-labelledby="videos-title">
      <div class="absolute inset-0 bg-gradient-to-br from-yellow/5 via-transparent to-rust/5"></div>
      <div class="relative mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16 lg:py-24">
        <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-3">BIBLIOTECA AUDIOVISUAL</p>
        <h1 class="font-pixel text-[clamp(2.5rem,7vw,5rem)] uppercase leading-[0.85]" id="videos-title">
          VÍDEOS
        </h1>
        <p class="mt-4 max-w-[60ch] text-text-muted text-sm leading-relaxed">
          Explora el archivo completo de análisis, explicaciones y debates. Ordena, filtra y encuentra
          exactamente lo que buscas.
        </p>

        <!-- Canal card -->
        <div class="mt-8 flex flex-col sm:inline-flex sm:flex-row sm:items-center gap-4 sm:gap-5 px-5 py-4 rounded-2xl border border-border bg-surface/60 backdrop-blur">
          <div class="w-14 h-14 rounded-full border-2 border-yellow/30 overflow-hidden">
            <img
              src="/assets/channel-avatar.jpg"
              alt={CHANNEL.name}
              width="120"
              height="120"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <div class="text-sm font-bold text-text font-display">{CHANNEL.name}</div>
            <div class="text-[10px] text-text-muted font-mono mt-0.5">{formatChannelNumber(String(CHANNEL.subscribersFallback))} SUSCRIPTORES</div>
          </div>
          <a
            href={channelUrl(CHANNEL.handle)}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-4 px-4 py-2 text-[10px] font-bold tracking-[.1em] text-yellow border border-yellow/30 rounded-lg hover:bg-yellow hover:text-bg transition-all"
          >
            VISITAR CANAL ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Vídeo destacado -->
    {featured && (
      <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16 border-b border-border" aria-label="Vídeo destacado">
        <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-8 items-start">
          <a
            href={`https://www.youtube.com/watch?v=${featured.videoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative rounded-2xl overflow-hidden border border-border"
          >
            <img
              src={thumbnailUrl(featured.videoId, 'maxresdefault')}
              alt={featured.title}
              width="1280"
              height="720"
              class="w-full aspect-video object-cover group-hover:scale-[1.02] transition-transform duration-700"
              onerror={`this.src='${thumbnailUrl(featured.videoId, 'hqdefault')}'`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-2 py-1 bg-yellow text-bg text-[9px] font-bold tracking-[.1em] uppercase font-mono rounded mb-3">
                VÍDEO DESTACADO
              </span>
              <h2 class="font-pixel text-2xl lg:text-3xl uppercase leading-tight">{featured.title}</h2>
            </div>
          </a>

          <div>
            <span class="text-[9px] font-bold tracking-[.12em] text-yellow uppercase font-mono">{featured.code}</span>
            <h3 class="mt-2 font-pixel text-xl uppercase">{featured.title}</h3>
            <p class="mt-3 text-text-muted text-sm leading-relaxed">{featured.description}</p>
            {featured.publishedAt && (
              <div class="mt-4 text-[10px] text-text-muted/60 font-mono">
                Publicado {relativeTime(featured.publishedAt)}
              </div>
            )}
            {featured.references && featured.references.length > 0 && (
              <div class="mt-6 space-y-3">
                <h4 class="text-[10px] font-bold tracking-[.12em] text-yellow uppercase font-mono">REFERENCIAS</h4>
                {featured.references.map((ref) => (
                  <a
                    href={ref.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex gap-3 p-3 rounded-xl border border-border bg-surface hover:border-yellow/30 transition-colors"
                  >
                    <img
                      src={ref.image}
                      alt={ref.imageAlt}
                      width="80"
                      height="45"
                      loading="lazy"
                      class="w-20 h-12 object-cover rounded-lg flex-shrink-0"
                      onerror={ref.imageFallback ? `this.src='${ref.imageFallback}'` : undefined}
                    />
                    <div class="min-w-0">
                      <div class="text-[8px] font-bold tracking-[.1em] text-yellow/60 uppercase font-mono">{ref.label}</div>
                      <div class="text-xs font-bold text-text mt-0.5 line-clamp-1">{ref.title}</div>
                      <div class="text-[10px] text-text-muted/60 font-mono mt-0.5">{ref.creator}</div>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Grid de vídeos (React island) -->
    <section class="mx-auto max-w-[var(--shell)] px-5 lg:px-8 py-16" aria-labelledby="all-title">
      <header class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="text-[10px] font-bold tracking-[.14em] text-yellow/80 uppercase font-mono mb-2">ARCHIVO COMPLETO</p>
          <h2 class="font-pixel text-[clamp(1.5rem,4vw,2.5rem)] uppercase" id="all-title">TODOS LOS VÍDEOS</h2>
        </div>
      </header>
      <VideoGrid client:load videos={VIDEOS} initialCategory={category ?? undefined} />
    </section>

    <Footer />
  </main>
</BaseLayout>
