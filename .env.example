# =============================================================
# Supabase
# Copiar este archivo como .env y rellenar los valores
# =============================================================

# URL del proyecto Supabase (Dashboard > Settings > API)
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Anon key pública (Dashboard > Settings > API > anon public)
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# =============================================================
# Scripts locales (NO exponer en el frontend ni en Vercel)
# Service role key: Dashboard > Settings > API > service_role
# Se usa solo para `pnpm video:sync` y `pnpm video:add`
# =============================================================

SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
